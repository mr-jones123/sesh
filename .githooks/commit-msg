#!/bin/sh
set -eu

message=$(sed -n '1p' "$1")
pattern='^(feat|fix|docs|refactor|test|chore|build|ci|perf|style|revert)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s\n' "$message" | grep -Eq "$pattern"; then
  echo "commit-msg: commit must use Conventional Commits format" >&2
  echo "Example: feat(cli): add session export" >&2
  exit 1
fi
